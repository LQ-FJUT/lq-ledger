{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "L.Q记账主窗口所需的最小权限",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:window:allow-unminimize",
    "core:window:allow-set-focus",
    "dialog:allow-open",
    "dialog:allow-save",
    "sql:default",
    "sql:allow-execute"
  ]
}
